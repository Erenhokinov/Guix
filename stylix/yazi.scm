(define-module (stylix yazi)
  ;;yazi

  #:export (yazi-toml keymap-toml theme-toml init-lua))

(define yazi-toml
  (string-append
   "[plugin]\n"
   "[[plugin.prepend_fetchers]]\n"
   "url   = \"*\"\n"
   "run   = \"git\"\n"
   "group = \"git\"\n\n"
   "[[plugin.prepend_fetchers]]\n"
   "url   = \"*/\"\n"
   "run   = \"git\"\n"
   "group = \"git\"\n"))

(define keymap-toml
  (string-append
   "[mgr]\n"
   "prepend_keymap = [\n"
   "  { on = [ \"g\", \"p\" ], run = \"cd ~/Projects\",    desc = \"Go to projects\" },\n"
   "  { on = [ \"g\", \"s\" ], run = \"cd ~/Screenshots\", desc = \"Go to screenshots\" },\n"
   "  { on = [ \"@\" ],       run = \"shell ' \\\"$@\\\"' --cursor=0 --interactive\", desc = \"Open shell\" },\n"
   "  { on = [ \"<C-h>\" ],   run = \"hidden toggle\", desc = \"Toggle hidden files\" },\n"
   "  { on = [ \"y\", \"y\" ], run = \"yank\",           desc = \"Yank (copy) files\" },\n"
   "  { on = [ \"y\", \"p\" ], run = \"copy path\",      desc = \"Copy file path\" },\n"
   "  { on = [ \"y\", \"d\" ], run = \"copy dirname\",   desc = \"Copy directory name\" },\n"
   "  { on = [ \"y\", \"n\" ], run = \"copy filename\",  desc = \"Copy filename\" },\n"
   "  { on = [ \"y\", \"N\" ], run = \"copy name_without_ext\", desc = \"Copy name without extension\" },\n"
   "  { on = [ \"d\", \"d\" ], run = \"yank --cut\",     desc = \"Cut files\" },\n"
   "  { on = [ \"d\", \"D\" ], run = \"remove --force\", desc = \"Delete permanently\" },\n"
   "  { on = [ \"p\", \"p\" ], run = \"paste\",          desc = \"Paste files\" },\n"
   "  { on = [ \"p\", \"P\" ], run = \"paste --force\",  desc = \"Paste (overwrite)\" },\n"
   "  { on = [ \"c\", \"d\" ], run = \"cd --interactive\", desc = \"Interactive cd\" },\n"
   "  { on = [ \"o\", \"m\" ], run = \"sort mtime --reverse=no\",       desc = \"Sort by mtime\" },\n"
   "  { on = [ \"o\", \"M\" ], run = \"sort mtime --reverse=yes\",      desc = \"Sort by mtime (reverse)\" },\n"
   "  { on = [ \"o\", \"b\" ], run = \"sort natural --reverse=no\",     desc = \"Sort naturally\" },\n"
   "  { on = [ \"o\", \"B\" ], run = \"sort natural --reverse=yes\",    desc = \"Sort naturally (reverse)\" },\n"
   "  { on = [ \"o\", \"a\" ], run = \"sort alphabetical --reverse=no\", desc = \"Sort alphabetically\" },\n"
   "  { on = [ \"o\", \"A\" ], run = \"sort alphabetical --reverse=yes\", desc = \"Sort alphabetically (reverse)\" },\n"
   "  { on = [ \"o\", \"e\" ], run = \"sort extension --reverse=no\",    desc = \"Sort by extension\" },\n"
   "  { on = [ \"o\", \"E\" ], run = \"sort extension --reverse=yes\",   desc = \"Sort by extension (reverse)\" },\n"
   "  { on = [ \"o\", \"s\" ], run = \"sort size --reverse=no\",         desc = \"Sort by size\" },\n"
   "  { on = [ \"o\", \"S\" ], run = \"sort size --reverse=yes\",        desc = \"Sort by size (reverse)\" },\n"
   "  { on = [ \"t\" ],       run = \"tab_create --current\", desc = \"New tab\" },\n"
   "  { on = [ \"x\" ],       run = \"close\",            desc = \"Close tab\" },\n"
   "  { on = [ \"J\" ],       run = \"tab_switch 1 --relative\",  desc = \"Next tab\" },\n"
   "  { on = [ \"<C-Tab>\" ], run = \"tab_switch 1 --relative\",  desc = \"Next tab\" },\n"
   "  { on = [ \"K\" ],       run = \"tab_switch -1 --relative\", desc = \"Previous tab\" },\n"
   "  { on = [ \"<C-BackTab>\" ], run = \"tab_switch -1 --relative\", desc = \"Previous tab\" },\n"
   "  { on = [ \"u\" ],       run = \"undo\",             desc = \"Undo\" },\n"
   "  { on = [ \"<C-r>\" ],   run = \"redo\",             desc = \"Redo\" },\n"
   "]\n"))

